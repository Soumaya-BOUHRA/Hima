# Copy to .env for local dev (server/.env). NEVER commit real secrets.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
# Comma-separated. Keep localhost for dev, add Vercel frontend URL in production:
# e.g. CLIENT_URL=http://localhost:5173,http://localhost:5174,https://hima-client.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:5174
